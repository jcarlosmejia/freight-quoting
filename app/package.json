{
  "name": "fletcot-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Implementación local propia, equivalente funcional parcial de Fletcot.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/main.ts",
    "migrate": "node server/cli.ts migrate",
    "seed": "node server/cli.ts seed",
    "setup": "npm run migrate && npm run seed && npm run build",
    "local": "npm run setup && npm start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "docxtemplater": "^3.71.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pizzip": "^3.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
