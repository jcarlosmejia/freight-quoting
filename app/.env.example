# Copia este archivo a .env y cambia los valores. No subas .env al repositorio.
HOST=127.0.0.1
PORT=5180
# Carpeta para la base SQLite, plantillas y logos (relativa a app/).
DATA_DIR=data
# Clave para cifrar secretos de integraciones (genera una larga y aleatoria).
APP_SECRET=
# Pon true sólo si sirves la app por HTTPS.
SECURE_COOKIES=false

# Datos del primer arranque (npm run seed). Cambia las contraseñas al entrar.
SEED_COMPANY_NAME=CARMAG TRANSPORTS
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin
SEED_USER_EMAIL=usuario@demo.test
SEED_USER_PASSWORD=cambia-esta-clave-usuario

# Proveedores de rutas opcionales (credenciales propias; nunca las de Fletcot).
# openrouteservice con perfil para camión (driving-hgv):
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
# Servidor OSRM autoalojado:
OSRM_URL=

# Mapa opcional (Leaflet). Plantilla de teselas XYZ de un servicio que puedas usar, p. ej. propio o con contrato.
# El servidor público de OpenStreetMap tiene política de uso: no para uso intensivo comercial.
MAP_TILES_URL=
MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors
# Búsqueda de direcciones: servidor Nominatim propio o con permiso de uso, y un contacto para el User-Agent.
NOMINATIM_URL=
GEOCODER_CONTACT=
